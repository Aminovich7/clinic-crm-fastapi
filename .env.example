# Copy this file to .env and replace EVERY placeholder below with a real
# value. Never commit .env, and never paste a real secret back into this
# file — it is tracked by git, so anything written here is public to
# everyone who can read the repository, forever.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# The password here must match POSTGRES_PASSWORD further down.
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME_DB_PASSWORD@db:5432/senamed_db

# Used by tests/conftest.py — a separate database on the same "db" service,
# created once with e.g. `docker compose exec db createdb -U postgres clinic_crm_test`.
TEST_DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME_DB_PASSWORD@db:5432/clinic_crm_test

# Used by the docker-compose "db" service to initialize the Postgres
# container — must match the credentials/db name embedded in DATABASE_URL
# above. Generate with: openssl rand -base64 24
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_DB=senamed_db

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
# REDIS_PASSWORD is passed to the redis container via --requirepass and must
# also appear in REDIS_URL. Generate with: openssl rand -base64 24
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379/0

# ---------------------------------------------------------------------------
# JWT
# ---------------------------------------------------------------------------
# SECRET_KEY signs every access and refresh token. Anyone who knows it can
# mint a valid superadmin token without a password, so treat it exactly like
# the superadmin password itself. Generate with: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------------------------------------------------------------------------
# First-run superadmin
# ---------------------------------------------------------------------------
# These seed the superadmin account on first startup only (see
# app/users/seed.py — it never overwrites an existing superadmin). Changing
# them later has no effect; use the Sozlamalar page / PATCH /users/superadmin
# to change the live credentials.
SUPERADMIN_USERNAME=CHANGE_ME_ADMIN_USERNAME
SUPERADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD

# ---------------------------------------------------------------------------
# Runtime behaviour
# ---------------------------------------------------------------------------
# "production" (default) or "development". Development relaxes a few
# production-only guards; never set it to development on a live server.
ENVIRONMENT=production

# Serve the interactive API docs at /docs, /redoc and /openapi.json. Off by
# default so the full API surface is not enumerable before login.
DOCS_ENABLED=false

# Set to true ONLY when the app sits behind a reverse proxy you control that
# overwrites X-Forwarded-For. If it is true without such a proxy, any client
# can spoof its IP and bypass the login rate limit. If it is false behind a
# proxy, every client shares one rate-limit bucket. See app/core/rate_limit.py.
TRUST_PROXY_HEADERS=false

# Leave true in production. Tests set it to false so the login rate limit
# does not make the suite flaky.
RATE_LIMIT_ENABLED=true
